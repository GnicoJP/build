+static void __iomem *spe_diag_gicr_base[8];
+
+static void spe_diag_init_mmio(void)
+{
+	int cpu;
+	for (cpu = 0; cpu < 8; cpu++) {
+		phys_addr_t addr = 0x0c040000ULL + (u64)cpu * 0x20000ULL + 0x10200ULL;
+		if (!spe_diag_gicr_base[cpu])
+			spe_diag_gicr_base[cpu] = ioremap(addr, 4);
+	}
+}
+
+static void spe_diag_dump_status(const char *tag)
+{
+	int cpu = smp_processor_id();
+	u32 val = 0xFFFFFFFF;
+	u64 pmbsr, pmsbptr, pmblimitr, pmscr;
+
+	spe_diag_init_mmio();
+
+	if (cpu >= 0 && cpu < 8 && spe_diag_gicr_base[cpu])
+		val = readl_relaxed(spe_diag_gicr_base[cpu]);
+
+	pmbsr = read_sysreg_s(SYS_PMBSR_EL1);
+	pmsbptr = read_sysreg_s(SYS_PMBPTR_EL1);
+	pmblimitr = read_sysreg_s(SYS_PMBLIMITR_EL1);
+	pmscr = read_sysreg_s(SYS_PMSCR_EL1);
+
+	pr_info("SPE_DIAG [%s] CPU %d: GICR_ISPENDR0=0x%08x (PPI_15-0=0x%04x: PPI5=%d PPI7=%d PPI10=%d), PMSCR=0x%llx, PMBSR=0x%llx (S=%d, COLL=%d), PMBPTR=0x%llx, PMBLIMITR=0x%llx\n",
+		tag, cpu, val, (val >> 16) & 0xFFFF,
+		!!(val & BIT(21)), !!(val & BIT(23)), !!(val & BIT(26)),
+		pmscr, pmbsr, (int)(pmbsr & 1), (int)!!(pmbsr & BIT(16)),
+		pmsbptr, pmblimitr);
+}
